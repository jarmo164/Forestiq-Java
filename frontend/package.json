{
  "name": "forestiq-frontend",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm lint:api-boundary && pnpm lint:parcel-detail-boundary && eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "generate:api-schema": "mkdir -p ../backend/build/openapi && curl -fsS ${OPENAPI_URL:-http://localhost:8080/api/openapi} -o ../backend/build/openapi/forestiq-openapi.json",
    "generate:api-types": "openapi-typescript ../backend/build/openapi/forestiq-openapi.json -o lib/generated/openapi.d.ts",
    "generate:api-client": "node scripts/generate-openapi-client.mjs",
    "generate:api": "pnpm generate:api-schema && pnpm generate:api-types && pnpm generate:api-client",
    "verify:api-contract": "pnpm generate:api && git diff --exit-code -- lib/generated/openapi.d.ts lib/generated/client.ts",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:coverage": "pnpm test:unit:coverage",
    "test:unit:coverage": "vitest run --coverage",
    "test:watch": "pnpm test:unit:watch",
    "test:unit:watch": "vitest",
    "test:e2e": "pnpm test:e2e:compose",
    "test:e2e:compose": "bash ../scripts/run-e2e.sh",
    "test:e2e:playwright": "playwright test",
    "lint:api-boundary": "node scripts/check-api-transport-boundary.mjs",
    "lint:parcel-detail-boundary": "node scripts/check-parcel-detail-boundary.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@tanstack/react-query": "^5.66.9",
    "@tanstack/react-table": "^8.21.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "keycloak-js": "^26.1.3",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^5.0.1",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.1.7",
    "jsdom": "^26.0.0",
    "openapi-typescript": "7.6.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-p293-qw3h-jr36",
        "GHSA-jrc7-96c5-q579",
        "GHSA-2xp9-vwfh-vxw4",
        "GHSA-rgj7-g3m4-5g8c",
        "GHSA-2883-xcg3-v3hh"
      ]
    }
  }
}
