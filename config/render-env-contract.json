{
  "schema_version": 1,
  "previews": {
    "generation": "off",
    "production_secrets_allowed": false
  },
  "services": {
    "forestiq-keycloak": {
      "required_env": [
        "PORT",
        "KC_HTTP_PORT",
        "KC_HTTP_ENABLED",
        "KC_PROXY_HEADERS",
        "KC_HOSTNAME",
        "KC_HOSTNAME_BACKCHANNEL_DYNAMIC",
        "KC_HEALTH_ENABLED",
        "KC_METRICS_ENABLED",
        "KC_DB",
        "KC_DB_URL_HOST",
        "KC_DB_URL_PORT",
        "KC_DB_URL_DATABASE",
        "KC_DB_USERNAME",
        "KC_DB_PASSWORD",
        "KC_DB_SCHEMA",
        "KC_DB_POOL_MAX_SIZE",
        "KC_BOOTSTRAP_ADMIN_USERNAME",
        "KC_BOOTSTRAP_ADMIN_PASSWORD",
        "FORESTIQ_WEB_URL",
        "FORESTIQ_INITIAL_ADMIN_PASSWORD",
        "FORESTIQ_KEYCLOAK_ADMIN_CLIENT_SECRET",
        "JAVA_OPTS_KC_HEAP"
      ],
      "secret_env": [
        "KC_DB_PASSWORD",
        "KC_BOOTSTRAP_ADMIN_PASSWORD",
        "FORESTIQ_INITIAL_ADMIN_PASSWORD",
        "FORESTIQ_KEYCLOAK_ADMIN_CLIENT_SECRET"
      ]
