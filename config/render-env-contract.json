        "SPRING_PROFILES_ACTIVE",
        "FORESTIQ_RUNTIME_ROLE",
        "DATABASE_URL",
        "DATABASE_USERNAME",
        "DATABASE_PASSWORD",
        "DATABASE_POOL_SIZE",
        "SPRING_FLYWAY_ENABLED",
        "CORS_ALLOWED_ORIGINS",
        "KEYCLOAK_PUBLIC_URL",
        "KEYCLOAK_REALM",
        "KEYCLOAK_ADMIN_REALM",
        "KEYCLOAK_ADMIN_CLIENT_ID",
        "KEYCLOAK_ADMIN_CLIENT_SECRET",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET",
        "S3_PATH_STYLE_ACCESS",
        "SENTRY_DSN",
        "FORESTIQ_NOTIFICATIONS_APP_BASE_URL",
        "FORESTIQ_NOTIFICATIONS_FROM",
        "FORESTIQ_NOTIFICATIONS_SCAN_DELAY_MS",
        "SPRING_MAIL_HOST",
        "SPRING_MAIL_PORT",
        "SPRING_MAIL_USERNAME",
        "SPRING_MAIL_PASSWORD",
        "SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH",
        "SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE"
      ],
      "secret_env": [
        "DATABASE_PASSWORD",
        "KEYCLOAK_ADMIN_CLIENT_SECRET",
        "S3_ENDPOINT",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET",
        "SENTRY_DSN",
        "FORESTIQ_NOTIFICATIONS_FROM",
        "SPRING_MAIL_HOST",
        "SPRING_MAIL_USERNAME",
        "SPRING_MAIL_PASSWORD"
      ]
    },
    "forestiq-ingest-scheduler": {
      "required_env": [
        "DATABASE_URL",
        "FORESTIQ_INGEST_COMPONENT",
        "FORESTIQ_INGEST_ENABLED_JOB_KEYS",
        "FORESTIQ_INGEST_SCHEDULER_POLL_SECONDS",
        "FORESTIQ_INGEST_SCHEDULER_LEASE_SECONDS",
        "FORESTIQ_INGEST_MAX_CATCHUP_WINDOWS"
      ],
      "secret_env": [
        "DATABASE_URL"
      ]
    },
    "forestiq-ingest-worker": {
      "required_env": [
        "DATABASE_URL",
        "FORESTIQ_INGEST_COMPONENT",
        "FORESTIQ_INGEST_ENABLED_JOB_KEYS",
        "FORESTIQ_INGEST_WORKER_ID",
        "FORESTIQ_INGEST_WORKER_POLL_SECONDS",
        "FORESTIQ_INGEST_HEARTBEAT_SECONDS",
        "FORESTIQ_INGEST_LEASE_SECONDS",
        "FORESTIQ_INGEST_TEMP_DIR",
        "METSIS_PORTFOLIO_URI",
        "METSIS_PORTFOLIO_AUTHORIZATION",
        "METSIS_PORTFOLIO_ORGANIZATION_ID",
        "WEASEL_API_BASE_URL",
        "WEASEL_API_ACCESS_TOKEN",
        "WEASEL_ORGANIZATION_ID",
        "INHERITANCE_SOURCE_BASE_URL",
        "INHERITANCE_SOURCE_API_TOKEN",
        "INHERITANCE_SOURCE_URI_TEMPLATE",
