# Local development template. Fill every blank secret before running Compose;
# production must supply secrets through its own secret manager or deployment
# environment. compose.yaml is local/development only.
LOCAL_PORT_HOST=127.0.0.1
# postgis/postgis:17-3.5 may require explicit amd64 emulation on Apple Silicon.
# Keeping the platform explicit prevents an unexplained architecture mismatch warning.
POSTGRES_PLATFORM=linux/amd64
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
KEYCLOAK_PORT=8180
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8080
FRONTEND_PORT=3000
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3101

# Application
POSTGRES_DB=forestiq
POSTGRES_USER=forestiq
POSTGRES_PASSWORD=
# Separate local runtime roles. POSTGRES_USER remains the local migration owner.
API_DATABASE_USER=forestiq_api_login
API_DATABASE_PASSWORD=
INGEST_DATABASE_USER=forestiq_ingest_login
INGEST_DATABASE_PASSWORD=
INGEST_ENABLED_JOB_KEYS=OWNER_CADASTRE_RELATIONS,WEASEL_OWNERSHIP_TRANSITIONS,INHERITANCE_NOTICES
# Comma-separated Spring job keys that Python owns during source-by-source cutover.
INGEST_PYTHON_JOB_KEYS=
INGEST_SCHEDULER_POLL_SECONDS=30
INGEST_SCHEDULER_LEASE_SECONDS=90
INGEST_MAX_CATCHUP_WINDOWS=2
INGEST_WORKER_ID=local-worker-1
INGEST_WORKER_POLL_SECONDS=2
INGEST_HEARTBEAT_SECONDS=15
INGEST_LEASE_SECONDS=90
DATABASE_POOL_SIZE=10

# Local PostGIS tuning for production-sized imports. These defaults prevent the
# development container from checkpointing every few seconds and spilling common
# geospatial/admin queries to disk with PostgreSQL's tiny upstream defaults.
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_MAX_WAL_SIZE=8GB
POSTGRES_MIN_WAL_SIZE=1GB
POSTGRES_LOG_MIN_DURATION_STATEMENT_MS=500

# Keycloak development administrator and realm client.
# The imported realm is named forestiq-dev to keep local tokens separate from production.
KEYCLOAK_ADMIN=forestiq-admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=forestiq-dev
KEYCLOAK_CLIENT_ID=forestiq-web
KEYCLOAK_ADMIN_API_CLIENT_SECRET=

# RabbitMQ local development account
RABBITMQ_DEFAULT_USER=forestiq-rabbit
RABBITMQ_DEFAULT_PASS=

# Object storage (MinIO locally; use S3/R2-compatible endpoint in production)
MINIO_ROOT_USER=forestiq-minio
MINIO_ROOT_PASSWORD=
S3_BUCKET=forestiq-documents
S3_REGION=us-east-1

# Public frontend variables
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=forestiq-dev
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=forestiq-web
NEXT_PUBLIC_MAPTILER_KEY=replace-with-maptiler-key

# Server-only variables
INTERNAL_API_BASE_URL=http://api:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAPTILER_API_KEY=replace-with-maptiler-key
SENTRY_DSN=

# Reminder notifications. In-app delivery works without SMTP. Email delivery is
# retried only when enabled by the user and requires a real SMTP account.
FORESTIQ_NOTIFICATIONS_APP_BASE_URL=http://localhost:3000
FORESTIQ_NOTIFICATIONS_FROM=no-reply@forestiq.local
FORESTIQ_NOTIFICATIONS_SCAN_DELAY_MS=60000
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Optional Estonian business-calendar policy exceptions, comma-separated YYYY-MM-DD.
FORESTIQ_BUSINESS_CALENDAR_ADDITIONAL_HOLIDAYS=
FORESTIQ_BUSINESS_CALENDAR_WORKING_DAY_OVERRIDES=

# Observability
GRAFANA_ADMIN_USER=forestiq-admin
GRAFANA_ADMIN_PASSWORD=

# Primary nationwide cadastre ingestion: Maa- ja Ruumiamet publishes this GPKG ZIP
# through Geoportaal and refreshes the downloadable files nightly. Keep the URL
# configurable so an authority endpoint change does not require a code release.
MARU_CADASTRE_SNAPSHOT_URL=https://s3.pilw.io/rp-kemit-kataster/ANDMED/Eesti_KATASTER_GPKG.zip
GEOSPATIAL_DOWNLOAD_DIR=./var/geospatial/cadastre
MARU_CADASTRE_CONNECT_TIMEOUT_SECONDS=15
MARU_CADASTRE_REQUEST_TIMEOUT_SECONDS=900
GEOSPATIAL_MINIMUM_FREE_BYTES=536870912
MARU_CADASTRE_USER_AGENT=ForestIQ/2.0

# External registry WFS endpoints. Nationwide cadastral WFS paging is legacy during
# the #228 migration and must not become canonical again after #242 cutover.
MAAAMET_WFS_URL=https://gsavalik.envir.ee/geoserver/kataster/wfs
MAAAMET_WFS_TIMEOUT_SECONDS=15
MAAAMET_WFS_MAX_ATTEMPTS=3
METSAREGISTER_WFS_URL=https://gsavalik.envir.ee/geoserver/metsaregister/ows
METSAREGISTER_WFS_TIMEOUT_SECONDS=15
METSAREGISTER_WFS_MAX_ATTEMPTS=3
METSAREGISTER_WFS_PAGE_SIZE=10000
METSAREGISTER_WFS_MAX_PAGES_PER_QUERY=1000
METSAREGISTER_WFS_SORT_FIELD=sys_id
METSAREGISTER_WFS_BULK_BATCH_SIZE=50
METSAREGISTER_WFS_BULK_PAGES_PER_RUN=10
METSAREGISTER_WFS_MIN_REQUEST_INTERVAL_MS=100
# Disabled by default. Admin reports ENABLED only when this flag is true and the provider configuration binds successfully.
REGISTRY_AUTO_REFRESH_ENABLED=false
REGISTRY_AUTO_REFRESH_DELAY_MS=21600000
REGISTRY_AUTO_REFRESH_BATCH_SIZE=25
REGISTRY_CADASTRE_MAX_AGE_HOURS=168
REGISTRY_FOREST_MAX_AGE_HOURS=24
# Registry audit evidence is hash/count based by default. Full payload capture is explicit, bounded and short-lived.
REGISTRY_AUDIT_RETENTION_DAYS=30
REGISTRY_AUDIT_TROUBLESHOOTING_RETENTION_HOURS=24
REGISTRY_AUDIT_MAX_STORED_PAYLOAD_BYTES=65536
REGISTRY_AUDIT_MAX_DIAGNOSTIC_SAMPLE_BYTES=8192
REGISTRY_AUDIT_FULL_PAYLOAD_ENABLED=false
REGISTRY_AUDIT_CLEANUP_DELAY_MS=21600000
# RIK is available only under the organisation's service agreement; never commit real credentials.
RIK_KINNISTUSRAAMAT_WSDL=https://kinnistusraamat.rik.ee/krteenused/kr_teenus.asmx?WSDL
RIK_KINNISTUSRAAMAT_USERNAME=
RIK_KINNISTUSRAAMAT_PASSWORD=

# Server-to-server inheritance notice source.
INHERITANCE_SOURCE_BASE_URL=
INHERITANCE_SOURCE_API_TOKEN=
INHERITANCE_SOURCE_URI_TEMPLATE=https://www.ametlikudteadaanded.ee/ee/-/parimisteated/parimismenetluse-algatamine/%04d/%02d/%02d/xml
INHERITANCE_SOURCE_USER_AGENT=ForestIQ/2.0
INHERITANCE_SOURCE_ZONE_ID=Europe/Tallinn
INHERITANCE_SOURCE_CONNECT_TIMEOUT_SECONDS=10
INHERITANCE_SOURCE_TIMEOUT_SECONDS=30
# Disabled by default; Spring and Compose both use 30 minutes when enabled.
INHERITANCE_SOURCE_AUTO_REFRESH_ENABLED=false
INHERITANCE_SOURCE_AUTO_REFRESH_DELAY_MS=1800000
INHERITANCE_SOURCE_AUTO_REFRESH_BATCH_SIZE=100
INHERITANCE_SOURCE_MAX_BACKFILL_DAYS=31

# Weasel publishes cadastral ownership-transition events.
WEASEL_API_BASE_URL=
WEASEL_API_ACCESS_TOKEN=
WEASEL_ORGANIZATION_ID=
WEASEL_API_TIMEOUT_SECONDS=15
WEASEL_API_MAX_ATTEMPTS=3
WEASEL_AUTO_REFRESH_ENABLED=false
WEASEL_AUTO_REFRESH_DELAY_MS=21600000
WEASEL_PAGE_SIZE=100
WEASEL_MAX_PAGES_PER_RUN=10
WEASEL_OVERLAP_HOURS=6
WEASEL_INITIAL_LOOKBACK_DAYS=14

# MetsIS/Forestek owner-to-cadastre portfolio feed.
METSIS_PORTFOLIO_URI=https://forestek.metsis.io/api/owners-test
METSIS_PORTFOLIO_AUTHORIZATION=
METSIS_PORTFOLIO_ORGANIZATION_ID=
METSIS_PORTFOLIO_TIMEOUT_SECONDS=30
METSIS_PORTFOLIO_MAX_ATTEMPTS=3
METSIS_PORTFOLIO_AUTO_SYNC_ENABLED=false
METSIS_PORTFOLIO_AUTO_SYNC_DELAY_MS=86400000
METSIS_PORTFOLIO_PAGE_SIZE=1000
METSIS_PORTFOLIO_MAX_PAGES_PER_RUN=100
