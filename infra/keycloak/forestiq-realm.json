{
  "realm": "forestiq-dev",
  "displayName": "ForestIQ Development",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      { "name": "ORG_ADMIN", "description": "Organization administrator" },
      { "name": "CRM_MANAGER", "description": "CRM manager" },
      { "name": "EVALUATOR", "description": "Forest evaluator" },
      { "name": "CALLER", "description": "Assigned owner caller" },
      { "name": "VIEWER", "description": "Read-only user" }
    ]
  },
  "clients": [
    {
      "clientId": "forestiq-web",
      "name": "ForestIQ Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://192.168.0.108:3000/*",
        "http://localhost:13000/*",
        "http://127.0.0.1:13000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000",
        "http://192.168.0.108:3000",
        "http://localhost:13000",
        "http://127.0.0.1:13000"
      ],
      "fullScopeAllowed": true,
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"],
      "attributes": {},
      "protocolMappers": [
        {
          "name": "organization_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "organization_id",
            "claim.name": "organization_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "subject",
            "claim.name": "sub",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "clientId": "forestiq-admin-api",
      "name": "ForestIQ Server Administration API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "forestiq-local-admin-api"
    }
  ],
  "users": [
    {
      "id": "11111111-2222-3333-4444-555555555555",
