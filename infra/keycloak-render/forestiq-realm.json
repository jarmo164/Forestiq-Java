{
  "realm": "forestiq",
  "displayName": "ForestIQ",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "ORG_ADMIN",
        "description": "Organization administrator"
      },
      {
        "name": "CRM_MANAGER",
        "description": "CRM manager"
      },
      {
        "name": "EVALUATOR",
        "description": "Forest evaluator"
      },
      {
        "name": "CALLER",
        "description": "Assigned owner caller"
      },
      {
        "name": "VIEWER",
        "description": "Read-only user"
      }
    ]
  },
  "clients": [
    {
      "clientId": "forestiq-web",
      "name": "ForestIQ Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "${FORESTIQ_WEB_URL}",
      "baseUrl": "${FORESTIQ_WEB_URL}",
      "redirectUris": [
        "${FORESTIQ_WEB_URL}/*"
      ],
      "webOrigins": [
        "${FORESTIQ_WEB_URL}"
      ],
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "organization_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "organization_id",
            "claim.name": "organization_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "subject",
            "claim.name": "sub",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "clientId": "forestiq-admin-api",
      "name": "ForestIQ Server Administration API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "${FORESTIQ_KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "clientAuthenticatorType": "client-secret"
    }
  ],
  "users": [
    {
      "id": "11111111-2222-3333-4444-555555555555",
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "ForestIQ",
      "lastName": "Admin",
      "email": "admin@forestiq.local",
      "credentials": [
        {
          "type": "password",
          "temporary": false,
          "value": "${FORESTIQ_INITIAL_ADMIN_PASSWORD}"
        }
      ],
      "realmRoles": [
        "ORG_ADMIN",
        "CRM_MANAGER",
        "EVALUATOR",
        "CALLER",
        "VIEWER"
      ],
      "attributes": {
        "subject": [
          "11111111-2222-3333-4444-555555555555"
        ],
        "organization_id": [
          "11111111-1111-1111-1111-111111111111"
        ]
      }
    },
    {
      "username": "service-account-forestiq-admin-api",
      "enabled": true,
      "serviceAccountClientId": "forestiq-admin-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "query-users",
          "view-realm",
          "view-users"
        ]
      }
    }
  ]
}
