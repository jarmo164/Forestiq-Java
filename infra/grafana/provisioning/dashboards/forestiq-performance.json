{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP latency p95 / p99",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "HTTP p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "HTTP p99",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "jOOQ DB latency p95 / p99",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(forestiq_db_jooq_query_latency_seconds_bucket[5m])))",
          "legendFormat": "DB p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(forestiq_db_jooq_query_latency_seconds_bucket[5m])))",
          "legendFormat": "DB p99",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate and 5xx rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "all requests/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx/s",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Datasource pool pressure",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum(hikaricp_connections_active)", "legendFormat": "active", "refId": "A"},
        {"expr": "sum(hikaricp_connections_idle)", "legendFormat": "idle", "refId": "B"},
        {"expr": "sum(hikaricp_connections_pending)", "legendFormat": "pending", "refId": "C"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Slow jOOQ query rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "expr": "sum by (type) (rate(forestiq_db_jooq_query_slow_total[5m]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Integration queue depth",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum(forestiq_integration_queue_depth)", "legendFormat": "queued", "refId": "A"},
        {"expr": "sum(forestiq_integration_queue_running)", "legendFormat": "running", "refId": "B"},
        {"expr": "sum(forestiq_integration_worker_active)", "legendFormat": "worker active", "refId": "C"}
      ]
    }
  ],
